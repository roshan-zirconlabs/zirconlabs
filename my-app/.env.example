# ==============================================================================
# POLYTRADE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Database (PostgreSQL — local, Neon, or Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/polytrade?schema=public"
# On Vercel use Supabase Connect → shared Transaction pooler URL (port 6543).
# DIRECT_URL="postgresql://..."   # optional, for migrations over IPv4

# 2. Authentication (NextAuth v5)
# openssl rand -base64 33
AUTH_SECRET=""
# MUST match the origin the browser actually lands on.
# Local development: http://localhost:3000   Production: https://polytrade.fi
# Do not also set NEXTAUTH_URL to a different origin — /api/health flags that.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# 3. Google OAuth — https://console.cloud.google.com/apis/credentials
# Register <AUTH_URL>/api/auth/callback/google as an authorised redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. This deployment's public address. TradingView alert URLs are built from it.
APP_URL="http://localhost:3000"

# 5. Bot runner
# Secret that derives each bot's TradingView alert URL. At least 24 characters
# (openssl rand -hex 24). Rotating it changes every alert URL.
BOT_SECRET=""
# Bearer secret for /api/runner/tick, which a scheduler calls every minute
# (Supabase pg_cron, cron-job.org, or `yarn worker`). openssl rand -hex 24
CRON_SECRET=""

# 6. Polymarket data
POLYMARKET_HOST="https://clob.polymarket.com"
POLYGON_RPC_URL="https://polygon-bor-rpc.publicnode.com"

# 7. Managed trading wallets (Privy) — required only for real-money trading.
# PolyTrade stores the wallet id and public address; Privy holds the key.
PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# 8. Polymarket builder key — required for live trading.
# The current CLOB rejects bare-EOA makers and requires a Deposit Wallet, whose
# gasless creation is authorized by a self-minted builder key (no Polymarket
# approval needed). Mint one: npx tsx --env-file=.env scripts/mint-builder-key.ts
POLYMARKET_BUILDER_KEY=""
POLYMARKET_BUILDER_SECRET=""
POLYMARKET_BUILDER_PASSPHRASE=""
# Optional: attribute bridge deposits to your builder (0x + 64 hex).
POLYMARKET_BUILDER_CODE=""

# 9. Live trading gate. Must be "true" before any real order can be sent.
# Leave false until you have completed a funded end-to-end test. Orders are
# sent from this server, so it must run in a region where Polymarket allows
# opening positions (not the US/UK/DE/FR/SG/AU...). vercel.json pins dub1.
POLYMARKET_LIVE_ENABLED="false"
# "off" skips the pre-trade region check (Polymarket still enforces it).
POLYMARKET_REGION_CHECK=""

# 10. Plans, paid in stablecoins on Polygon (no card payments).
# Your treasury wallet. Users send USDC, USDC.e or pUSD here; each invoice asks
# for a unique amount, so the runner matches transfers automatically.
PAYMENT_ADDRESS=""
