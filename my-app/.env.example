# ==============================================================================
# ZIRCON — ENVIRONMENT CONFIGURATION
# Practice mode works with sections 1–4 only. Live trading needs 5–6.
# ==============================================================================

# 1. Database (PostgreSQL — Supabase, Neon or local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zircon?schema=public"
# On Vercel use Supabase Connect → shared Transaction pooler URL (port 6543).
# DIRECT_URL="postgresql://..."   # optional, used by migrations

# 2. Authentication (NextAuth v5)
# openssl rand -base64 33
AUTH_SECRET=""
# The origin the browser lands on (after any redirect).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Google OAuth — register <AUTH_URL>/api/auth/callback/google as a redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 3. Public origin used in TradingView webhook links. Must be the final
# canonical domain — TradingView does not follow redirects (so www, not apex).
APP_URL="https://www.zirconlabs.org"

# 4. Automation engine. Something must call the engine regularly:
#   • `yarn worker` on an always-on host (checks every 5s), and/or
#   • GET /api/cron/tick with "Authorization: Bearer $CRON_SECRET" every minute
#     (Vercel Cron on Pro, or a free scheduler such as cron-job.org).
# openssl rand -hex 24
CRON_SECRET=""
POLYGON_RPC_URL="https://polygon-bor-rpc.publicnode.com"

# 5. Live wallets (Privy server wallets). Zircon stores the wallet id and
# public address; Privy holds the key.
PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# 6. Polymarket builder key — needed to create and trade from Deposit Wallets
# through Polymarket's gasless relayer. Mint one:
#   node --import tsx --env-file=.env scripts/mint-builder-key.ts
POLYMARKET_BUILDER_KEY=""
POLYMARKET_BUILDER_SECRET=""
POLYMARKET_BUILDER_PASSPHRASE=""
# Optional: attribute bridge deposits to your builder (0x + 64 hex).
POLYMARKET_BUILDER_CODE=""
# Operator switch. Each user must also turn live trading on for their account.
POLYMARKET_LIVE_ENABLED="false"

# 7. Telegram alerts (optional). Create a bot with @BotFather, then run
# `yarn telegram:setup` once after deploying.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=""
