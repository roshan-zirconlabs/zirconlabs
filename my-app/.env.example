# ==============================================================================
# ZIRCON LABS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Database (PostgreSQL — local, Neon, or Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zircon_labs?schema=public"
# On Vercel use Supabase Connect → shared Transaction pooler URL (port 6543).
# DIRECT_URL="postgresql://..."   # optional, for migrations over IPv4

# 2. Authentication (NextAuth v5)
# openssl rand -base64 33
AUTH_SECRET=""
# MUST match the origin the browser actually lands on.
# Local development: http://localhost:3000   Production: https://www.zirconlabs.org
# Do not also set NEXTAUTH_URL to a different origin — /api/health flags that.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# 3. Google OAuth — https://console.cloud.google.com/apis/credentials
# Register <AUTH_URL>/api/auth/callback/google as an authorised redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. Workflow engine (KeeperHub)
KEEPERHUB_BASE_URL="https://app.keeperhub.com"
KEEPERHUB_APP_URL="https://app.keeperhub.com"
# Platform organization key. When set, users never handle a KeeperHub key:
# Zircon creates and runs their workflows in this organization. A user may still
# connect their own kh_ key in /connections, which then takes precedence.
# Workflows use the HTTP Request action, which needs a KeeperHub Pro plan.
KEEPERHUB_API_KEY=""

# 5. Callbacks from KeeperHub into this deployment
# Public HTTPS origin KeeperHub calls back on. Falls back to AUTH_URL when unset.
ZLABS_PUBLIC_URL="https://www.zirconlabs.org"
# Secret that derives each bot's callback token. At least 24 characters.
# Rotating it invalidates every published workflow's token — republish after.
ZLABS_INGEST_SECRET=""

# 6. Credential encryption — exactly 64 hex characters
# openssl rand -hex 32
ENCRYPTION_KEY=""

# 7. Polymarket data
POLYMARKET_HOST="https://clob.polymarket.com"
POLYGON_RPC_URL="https://polygon-bor-rpc.publicnode.com"

# 8. Managed trading wallets (Privy) — required only for real-money trading.
# Zircon stores the wallet id and public address; Privy holds the key.
PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# 9. Polymarket builder key — required for live trading.
# The current CLOB rejects bare-EOA makers and requires a Deposit Wallet, whose
# gasless creation is authorized by a self-minted builder key (no Polymarket
# approval needed). Mint one: npx tsx --env-file=.env scripts/mint-builder-key.ts
POLYMARKET_BUILDER_KEY=""
POLYMARKET_BUILDER_SECRET=""
POLYMARKET_BUILDER_PASSPHRASE=""
# Optional: attribute bridge deposits to your builder (0x + 64 hex).
POLYMARKET_BUILDER_CODE=""

# 10. Live trading gates. Both must be "true" before any real order can be sent.
# Leave false until you have completed a funded end-to-end test.
POLYMARKET_CLOB_V2_ADAPTER_READY="false"
POLYMARKET_LIVE_ENABLED="false"

# 11. Stripe billing (optional — /billing reports "not configured" without it)
APP_URL="http://localhost:3000"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""
