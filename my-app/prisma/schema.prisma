generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Every order, position and automation belongs to one book. Practice is
/// simulated against the real order book; Live places real orders.
enum TradingMode {
  PAPER
  LIVE
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// The book the app shows and new automations default to.
  mode      TradingMode @default(PAPER)
  /// Practice cash in USD.
  paperCash Decimal     @default(1000) @db.Decimal(14, 6)

  /// Telegram chat that receives alerts, linked with a one-time code.
  telegramChatId      String?   @unique
  telegramLinkCode    String?   @unique
  telegramLinkExpires DateTime?

  accounts       Account[]
  sessions       Session[]
  tradingAccount TradingAccount?
  paperPositions PaperPosition[]
  automations    Automation[]
  orders         Order[]
  activity       Activity[]
  withdrawals    Withdrawal[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// A user's live Polymarket account: a provider-held signer (never stored
/// here) and the Deposit Wallet that holds funds and makes orders.
model TradingAccount {
  id                   String   @id @default(cuid())
  userId               String   @unique
  provider             String   @default("privy")
  providerWalletId     String   @unique
  signerAddress        String   @unique
  depositWalletAddress String?  @unique
  liveEnabled          Boolean  @default(false)
  /// Most USD of live buys allowed per UTC day.
  dailyLimitUsd        Decimal  @default(100) @db.Decimal(12, 2)
  /// Kill switch: nothing live is placed while set.
  paused               Boolean  @default(false)
  /// Last time winnings were checked for automatic claiming.
  lastClaimCheckAt     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Practice holdings. Live holdings are read from Polymarket, never stored.
model PaperPosition {
  id          String    @id @default(cuid())
  userId      String
  tokenId     String
  conditionId String
  marketSlug  String
  question    String
  outcome     String
  shares      Decimal   @db.Decimal(20, 6)
  /// Total paid for the shares still held, including fees.
  costUsd     Decimal   @db.Decimal(14, 6)
  endDate     DateTime?
  settledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenId])
  @@index([settledAt])
}

enum AutomationKind {
  /// Sells a held position on take-profit, stop-loss, trailing stop or time.
  EXIT
  /// Buys when the price reaches a level.
  ENTRY
  /// Buys or sells when an external alert (e.g. TradingView) arrives.
  WEBHOOK
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  DONE
  CANCELLED
  FAILED
}

model Automation {
  id                String           @id @default(cuid())
  userId            String
  mode              TradingMode
  kind              AutomationKind
  status            AutomationStatus @default(ACTIVE)
  tokenId           String
  conditionId       String
  marketSlug        String
  question          String
  outcome           String
  endDate           DateTime?
  /// User settings, validated per kind by lib/automations/config.ts.
  config            Json
  /// Engine-owned state such as a trailing stop's peak price.
  state             Json             @default("{}")
  /// SHA-256 of a webhook automation's secret; the secret itself is shown once.
  webhookSecretHash String?          @unique
  /// Lease that stops two workers acting on the same automation at once.
  lockedUntil       DateTime?
  lastPrice         Decimal?         @db.Decimal(10, 6)
  lastCheckedAt     DateTime?
  lastError         String?          @db.Text
  firedAt           DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders   Order[]
  activity Activity[]

  @@index([status])
  @@index([userId, createdAt])
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  /// Recorded before the order is sent; stays here only if the process died.
  SUBMITTING
  FILLED
  PARTIAL
  /// Nothing matched within the price limit.
  UNFILLED
  REJECTED
  /// The exchange queued matching; it may still fill.
  QUEUED
  /// The request may have reached the exchange; never retried blindly.
  UNKNOWN
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  automationId    String?
  mode            TradingMode
  side            OrderSide
  tokenId         String
  conditionId     String
  marketSlug      String
  question        String
  outcome         String
  /// BUY: all-in USD to spend. SELL: shares to sell.
  requested       Decimal     @db.Decimal(20, 6)
  /// BUY: highest acceptable price. SELL: lowest acceptable price.
  limitPrice      Decimal     @db.Decimal(10, 6)
  filledShares    Decimal     @default(0) @db.Decimal(20, 6)
  /// BUY: USD spent including fees. SELL: USD received after fees.
  filledUsd       Decimal     @default(0) @db.Decimal(14, 6)
  feeUsd          Decimal     @default(0) @db.Decimal(14, 6)
  status          OrderStatus @default(SUBMITTING)
  exchangeOrderId String?
  txHashes        String[]
  reason          String
  error           String?     @db.Text
  /// One order per intent: a retried request finds this row instead of trading twice.
  idempotencyKey  String      @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
}

enum ActivityLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

/// The audit trail: what happened and why. Also the queue for alerts.
model Activity {
  id           String         @id @default(cuid())
  userId       String
  automationId String?
  orderId      String?
  mode         TradingMode?
  level        ActivityLevel  @default(INFO)
  title        String
  detail       String?        @db.Text
  notifiedAt   DateTime?
  createdAt    DateTime       @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([notifiedAt, level])
}

/// A request to move collateral out of a user's trading wallet. Recorded before
/// the transfer is signed so a retry cannot send the same withdrawal twice.
model Withdrawal {
  id          String   @id @default(cuid())
  userId      String
  requestId   String
  destination String
  amountUsd   Decimal  @db.Decimal(12, 6)
  status      String   @default("SUBMITTING")
  txHash      String?
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, createdAt])
}
