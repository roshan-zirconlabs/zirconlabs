generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String    @id @default(cuid())
  email                   String?   @unique
  name                    String?
  image                   String?
  walletAddress           String?   @unique
  polymarketAccountType   String? // EOA, POLY_PROXY, POLY_GNOSIS_SAFE, or POLY_1271
  polymarketSignerAddress String?
  emailVerified           DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  bots                Bot[]
  subscription        Subscription?
  backtestResults     BacktestResult[]
  trades              Trade[]
  keeperhubConnection KeeperhubConnection?
  polymarketManagedAccount PolymarketManagedAccount?
  polymarketOrderAttempts PolymarketOrderAttempt[]
}

/// Durable duplicate-request guard and budget reservation for signed test buys.
/// Uncertain submissions retain their reservation until reconciled.
model PolymarketOrderAttempt {
  id          String   @id @default(cuid())
  userId      String
  requestId   String
  marketSlug  String
  outcome     String
  assetId     String
  amountUsd   Decimal  @db.Decimal(12, 2)
  maxPrice    Decimal  @db.Decimal(10, 6)
  status      String   @default("SUBMITTING")
  orderId     String?
  receipt     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, requestId])
  @@index([userId, createdAt])
}

/// One isolated Polygon-capable signing wallet per user. The private key is
/// held by the configured wallet provider (Privy in production), never here.
model PolymarketManagedAccount {
  id                String   @id @default(cuid())
  userId            String   @unique
  provider          String   @default("privy")
  providerWalletId  String   @unique
  walletAddress     String   @unique
  status            String   @default("ACTIVE")
  liveEnabled       Boolean  @default(false)
  dailyLimitUsd     Float    @default(100)
  lastCheckedAt     DateTime?
  lastError         String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model KeeperhubConnection {
  userId       String   @id
  encryptedKey String   @db.Text
  keyPrefix    String
  verifiedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// A bot in ZLabs is just a pointer to a KeeperHub workflow.
/// All bot logic, triggers, and execution live on KeeperHub. ZLabs only owns
/// the user's identity and the link to their KH workflow.
model Bot {
  id                  String    @id @default(cuid())
  userId              String
  name                String
  status              BotStatus @default(INACTIVE)
  keeperhubWorkflowId String?   @unique
  workflow            Json?
  /// Guided strategy spec (lib/workflow/strategy.ts). Null for raw-canvas bots.
  strategy            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]

  @@index([userId])
  @@index([keeperhubWorkflowId])
}

enum BotStatus {
  ACTIVE
  INACTIVE
  PAUSED
  ERROR
}

/// Mirror of trades that originated from a KeeperHub workflow run. Populated
/// only by `POST /api/ingest/trade` (called by the workflow's HTTP-Request node).
model Trade {
  id         String      @id @default(cuid())
  userId     String
  botId      String?
  signal     Signal
  marketSlug String
  tokenId    String
  direction  Direction
  side       TradeSide
  amount     Float
  price      Float
  shares     Float?
  status     TradeStatus @default(PENDING)
  orderId    String?
  pnl        Float?
  pnlPct     Float?
  executedAt DateTime?
  closedAt   DateTime?
  closePrice Float?
  createdAt  DateTime    @default(now())

  keeperhubExecutionId String? @unique
  keeperhubRunId       String?
  paper                Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  Bot? @relation(fields: [botId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([botId])
  @@index([marketSlug])
  @@index([status])
  @@index([keeperhubExecutionId])
}

enum Signal {
  BUY
  SELL
}

enum Direction {
  UP
  DOWN
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  PENDING
  FILLED
  PARTIALLY_FILLED
  FAILED
  CANCELLED
  CLOSED
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 Plan               @default(FREE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

model BacktestResult {
  id          String   @id @default(cuid())
  userId      String
  name        String   @default("Untitled")
  csvHash     String
  marketType  String
  totalTrades Int      @default(0)
  winRate     Float    @default(0)
  totalPnl    Float    @default(0)
  maxDrawdown Float    @default(0)
  summary     Json
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
