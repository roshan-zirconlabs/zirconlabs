generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String    @id @default(cuid())
  email                   String?   @unique
  name                    String?
  image                   String?
  walletAddress           String?   @unique
  polymarketAccountType   String? // EOA, POLY_PROXY, POLY_GNOSIS_SAFE, or POLY_1271
  polymarketSignerAddress String?
  emailVerified           DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  bots                     Bot[]
  subscription             Subscription?
  backtestResults          BacktestResult[]
  trades                   Trade[]
  polymarketManagedAccount PolymarketManagedAccount?
  polymarketOrderAttempts  PolymarketOrderAttempt[]
  walletWithdrawals        WalletWithdrawal[]
  payments                 Payment[]
}

/// A request to move collateral out of a user's trading wallet. Recorded before
/// the transfer is signed so a retry cannot send the same withdrawal twice.
model WalletWithdrawal {
  id          String   @id @default(cuid())
  userId      String
  requestId   String
  destination String
  amountUsd   Decimal  @db.Decimal(12, 6)
  status      String   @default("SUBMITTING")
  txHash      String?
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, createdAt])
}

/// Durable duplicate-request guard and budget reservation for signed test buys.
/// Uncertain submissions retain their reservation until reconciled.
model PolymarketOrderAttempt {
  id         String   @id @default(cuid())
  userId     String
  requestId  String
  marketSlug String
  outcome    String
  assetId    String
  amountUsd  Decimal  @db.Decimal(12, 2)
  maxPrice   Decimal  @db.Decimal(10, 6)
  status     String   @default("SUBMITTING")
  orderId    String?
  receipt    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, requestId])
  @@index([userId, createdAt])
}

/// One isolated Polygon-capable signing wallet per user. The private key is
/// held by the configured wallet provider (Privy in production), never here.
model PolymarketManagedAccount {
  id                   String    @id @default(cuid())
  userId               String    @unique
  provider             String    @default("privy")
  providerWalletId     String    @unique
  walletAddress        String    @unique
  /// Polymarket Deposit Wallet derived from walletAddress (the signer). Funds
  /// live here and it is the order maker; resolved lazily and cached.
  depositWalletAddress String?   @unique
  status               String    @default("ACTIVE")
  liveEnabled          Boolean   @default(false)
  dailyLimitUsd        Float     @default(100)
  lastCheckedAt        DateTime?
  lastError            String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// A bot: one trigger (schedule or alert), one rule and one order, described
/// by `strategy` and executed by the PolyTrade runner (lib/runner).
model Bot {
  id                  String    @id @default(cuid())
  userId              String
  name                String
  status              BotStatus @default(INACTIVE)
  workflow            Json?
  /// Guided strategy spec (lib/workflow/strategy.ts). Null for raw-canvas bots.
  strategy            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  /// Set when the owner publishes this strategy to the public track-record feed.
  listedAt            DateTime?
  /// Last market window the PolyTrade runner claimed for this bot, so one
  /// window is evaluated once however many ticks arrive.
  lastEvaluatedWindow Int?

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]
  runs   BotRun[]

  @@index([userId])
}

/// One evaluation by the PolyTrade runner: a trade, a sit-out or a failure.
model BotRun {
  id         String   @id @default(cuid())
  botId      String
  /// schedule | alert | manual
  source     String
  /// TRADED | SAT_OUT | FAILED | DUPLICATE
  outcome    String
  reason     String?  @db.Text
  marketSlug String?
  direction  String?
  amount     Float?
  shares     Float?
  price      Float?
  paper      Boolean?
  tradeId    String?
  durationMs Int?
  startedAt  DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, startedAt])
}

/// One row ("runner") updated on every runner tick. /api/health reads it to
/// tell whether the scheduler is calling the runner, and the write is the
/// database activity that keeps a free Supabase project from pausing.
model RunnerHeartbeat {
  id          String   @id
  lastTickAt  DateTime
  lastSummary Json?
}

enum BotStatus {
  ACTIVE
  INACTIVE
  PAUSED
  ERROR
}

/// A practice fill or a real order placed by a bot.
model Trade {
  id         String      @id @default(cuid())
  userId     String
  botId      String?
  signal     Signal
  marketSlug String
  tokenId    String
  direction  Direction
  side       TradeSide
  amount     Float
  price      Float
  shares     Float?
  status     TradeStatus @default(PENDING)
  orderId    String?
  pnl        Float?
  pnlPct     Float?
  executedAt DateTime?
  closedAt   DateTime?
  closePrice Float?
  createdAt  DateTime    @default(now())

  /// One id per bot, market and window: the duplicate-order guard.
  requestId String? @unique
  paper     Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  Bot? @relation(fields: [botId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([botId])
  @@index([marketSlug])
  @@index([status])
}

enum Signal {
  BUY
  SELL
}

enum Direction {
  UP
  DOWN
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  PENDING
  FILLED
  PARTIALLY_FILLED
  FAILED
  CANCELLED
  CLOSED
}

/// A user's plan. Paid plans run until `currentPeriodEnd`; after that the
/// user is on FREE again. Paid for on-chain (see Payment), never by card.
model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  plan             Plan               @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// An invoice paid in stablecoins on Polygon. Each open invoice asks for a
/// unique amount, so an incoming transfer to the treasury matches exactly one
/// invoice; the transaction hash is the receipt.
model Payment {
  id          String        @id @default(cuid())
  userId      String
  plan        Plan
  /// Amount due in token base units (6 decimals), unique among open invoices.
  amountUnits String
  status      PaymentStatus @default(PENDING)
  expiresAt   DateTime
  txHash      String?       @unique
  token       String?
  fromAddress String?
  blockNumber Int?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, amountUnits])
  @@index([userId, createdAt])
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
}

/// Last Polygon block scanned for payments.
model ChainCursor {
  id    String @id
  block Int
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
}

model BacktestResult {
  id          String   @id @default(cuid())
  userId      String
  name        String   @default("Untitled")
  csvHash     String
  marketType  String
  totalTrades Int      @default(0)
  winRate     Float    @default(0)
  totalPnl    Float    @default(0)
  maxDrawdown Float    @default(0)
  summary     Json
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
