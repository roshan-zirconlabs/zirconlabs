{
  "name": "zircon-labs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "db:migrate": "prisma migrate deploy",
    "lint": "eslint",
    "test": "node --conditions=react-server --import tsx --test \"lib/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "worker": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "tick": "node --conditions=react-server --env-file-if-exists=.env --import tsx -e \"import('./lib/engine/tick.ts').then(m=>m.runTick()).then(r=>{console.log(JSON.stringify(r));process.exit(0)})\"",
    "telegram:setup": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/telegram-setup.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@polymarket/builder-signing-sdk": "^1.0.0",
    "@polymarket/client": "^0.10.0",
    "@polymarket/clob-client": "5.8.1",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@privy-io/node": "0.15.0",
    "@tanstack/react-query": "^5.90.21",
    "@types/pg": "^8.23.1",
    "@vercel/analytics": "^2.0.1",
    "ethers": "5.7.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "viem": "^2.47.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
